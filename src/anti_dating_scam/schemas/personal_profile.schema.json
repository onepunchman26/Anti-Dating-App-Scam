{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ai-slowmatch.local/schemas/personal_profile.schema.json",
  "title": "AI-SlowMatch Local Personal Relationship Profile",
  "type": "object",
  "required": [
    "schema_version",
    "created_at",
    "updated_at",
    "owner_label",
    "source_summary",
    "relationship_values",
    "boundary_preferences",
    "communication_preferences",
    "risk_tolerance_notes",
    "trust_ladder_preferences",
    "self_reflection_notes",
    "uncertainty_notes"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "0.1"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "owner_label": {
      "type": "string",
      "minLength": 1
    },
    "source_summary": {
      "type": "object",
      "required": [
        "manual_notes_used",
        "chatgpt_export_used",
        "memory_summary_used"
      ],
      "properties": {
        "manual_notes_used": {
          "type": "boolean"
        },
        "chatgpt_export_used": {
          "type": "boolean"
        },
        "memory_summary_used": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "relationship_values": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "boundary_preferences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "communication_preferences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risk_tolerance_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "trust_ladder_preferences": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "self_reflection_notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uncertainty_notes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
